{
  "name": "@twinforce/homebridge-miot",
  "displayName": "Xiaomi MIoT",
  "version": "0.2.2-e12.16",
  "description": "Native Apple Home integration for Xiaomi MIoT devices: Air Purifier 4 Compact and Robot Vacuum E10/E12.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.4.0"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "xiaomi",
    "miot",
    "air-purifier",
    "supports-matter",
    "robot-vacuum",
    "matter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmtrwff/homebridge-miot-e12.git"
  },
  "bugs": {
    "url": "https://github.com/dmtrwff/homebridge-miot-e12/issues"
  },
  "homepage": "https://github.com/dmtrwff/homebridge-miot-e12#readme",
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts scripts/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "homebridge": "^2.4.0",
    "typescript": "~5.9.3",
    "tsx": "^4.20.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
