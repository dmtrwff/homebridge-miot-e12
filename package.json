{
  "name": "homebridge-miot-e12",
  "displayName": "Xiaomi Robot Vacuum E12",
  "version": "0.2.2-e12.20",
  "description": "Homebridge Matter plugin for Xiaomi Robot Vacuum E12 with local control and native Apple Home integration.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.4.0"
  },
  "keywords": [
    "homebridge-plugin",
    "xiaomi",
    "miot",
    "supports-matter",
    "robot-vacuum",
    "matter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmtrwff/homebridge-miot-e12.git"
  },
  "bugs": {
    "url": "https://github.com/dmtrwff/homebridge-miot-e12/issues"
  },
  "homepage": "https://github.com/dmtrwff/homebridge-miot-e12#readme",
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "homebridge": "^2.4.0",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
